<script>
// Random Link functionality
document.getElementById('randomLink').addEventListener('click', function () {
    var randomSites = [
        'https://puginarug.com/',
        'https://longdogechallenge.com/',
        'https://maze.toys/mazes/mini/daily/',
        'https://cursoreffects.com/', 
        'https://onesquareminesweeper.com/',
        'https://mondrianandme.com/',
        'https://thatsthefinger.com/',
        'https://eelslap.com/',
        'https://binarypiano.com/',
        'https://www.boredbutton.com/random',
        'https://hooooooooo.com/',
        'https://floatingqrcode.com/',
        'https://burymewithmymoney.com/',
        'https://www.koalastothemax.com/',
        'https://checkboxrace.com/',
    ];
    var randomIndex = Math.floor(Math.random() * randomSites.length);
    var randomURL = randomSites[randomIndex];
    window.location.href = randomURL;
});

// Post functionality
document.getElementById('createPostLink').addEventListener('click', function () {
    var postTitle = prompt("Enter your post title:");
    if (postTitle) {
        var postContent = prompt("Enter your post content:");
        if (postContent) {
            // Create post object
            var post = {
                title: postTitle,
                content: postContent,
                id: Date.now()
            };

            // Get posts from localStorage
            var posts = JSON.parse(localStorage.getItem('posts')) || [];

            // Add new post
            posts.push(post);
            localStorage.setItem('posts', JSON.stringify(posts));

            // Add post to the page
            displayPosts();
        } else {
            alert("Post content is required.");
        }
    } else {
        alert("Post title is required.");
    }
});

function displayPosts() {
    var postsList = document.getElementById('postsList');
    postsList.innerHTML = ''; // Clear current list

    var posts = JSON.parse(localStorage.getItem('posts')) || [];

    posts.forEach(function (post) {
        var li = document.createElement('li');
        var link = document.createElement('a');
        link.href = 'html/post.html?id=' + post.id; // Link to the post page
        link.textContent = post.title;
        li.appendChild(link);
        postsList.appendChild(li);
    });
}

// Display posts on page load
window.onload = function() {
    displayPosts();
};
</script>

