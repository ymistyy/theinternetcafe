<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Post Details</title>
    <link href="css/style.css" rel="stylesheet">
</head>
<body>

    <header>
        <pre>
     ______ __         ____      __                       __    _____       ___    
    /_  __// /  ___   /  _/___  / /_ ___  ____ ___  ___  / /_  / ___/___ _ / _/___ 
     / /  / _ \/ -_) _/ / / _ \/ __// -_)/ __// _ \/ -_)/ __/ / /__ / _ `// _// -_)
    /_/  /_//_/\__/ /___//_//_/\__/ \__//_/  /_//_/\__/ \__/  \___/ \_,_//_/  \__/ 
        </pre>
    </header>

    <main>
        <div class="top-border">
            <section id="post-details">
                <h4>Post Details</h4>
                <div id="postContent"></div>
            </section>
        </div>
        <br>
    </main>

    <script>
        const postFile = 'https://raw.githubusercontent.com/YOUR_USERNAME/YOUR_REPOSITORY/main/posts.json';

        function getPostById(id) {
            return fetch(postFile)
                .then(response => response.json())
                .then(data => data.find(post => post.id === id));
        }

        function loadPost() {
            const urlParams = new URLSearchParams(window.location.search);
            const id = parseInt(urlParams.get('id'), 10);

            getPostById(id)
                .then(post => {
                    if (post) {
                        document.getElementById('postContent').innerHTML = `
                            <h3>${post.title}</h3>
                            <p><strong>Username:</strong> ${post.username}</p>
                            <p><strong>Date:</strong> ${new Date(post.timestamp).toLocaleString()}</p>
                            <p>${post.content}</p>
                        `;
                    } else {
                        document.getElementById('postContent').innerHTML = '<p>Post not found.</p>';
                    }
                })
                .catch(error => console.error('Error loading post:', error));
        }

        loadPost();
    </script>

    <footer>
        <a href="index.html">Back to Home</a>
        <p>© 2023 No rights reserved. A Yordi production. Powered by GitHub Pages!</p>
    </footer>

</body>
</html>
